PORT=5000
MONGO_URI=mongodb://localhost:27017/ganesh-mandal-db
JWT_SECRET=ganesh_mandal_super_secret_key_change_in_prod

# -------------------------------------------------------------
# Razorpay Payment Gateway (Branch: V2RA)
# Get your API keys from Razorpay Dashboard -> Settings -> API Keys
# -------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET
# Secret configured when setting up Webhook in Razorpay Dashboard
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# Yearly Plan Price in INR (e.g. 999 for ₹999/year)
PRO_PLAN_PRICE_INR=999
RAZORPAY_PLAN_PRODUCT_ID=artist_finance_pro_yearly

# -------------------------------------------------------------
# Google Play Billing (Retained for shared DB compatibility)
# -------------------------------------------------------------
GOOGLE_PLAY_PACKAGE_NAME=com.omdhavale15.ArtFinanceManagementFE
GOOGLE_PLAY_SUBSCRIPTION_PRODUCT_ID=artist_finance_pro_yearly
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"YOUR_PROJECT_ID"}
GOOGLE_PUBSUB_AUDIENCE=https://YOUR_BACKEND_HOST/api/billing/google-rtdn
GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL=YOUR_PUBSUB_PUSH_AUTH_SERVICE_ACCOUNT_EMAIL
